# Server
NODE_ENV=production
PORT=3001

# Required: use a long random value, never commit the real value
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Required MongoDB Atlas or self-hosted MongoDB connection
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bagcheck

# Comma-separated browser origins allowed to call this API
FRONTEND_URLS=https://your-frontend-domain.example

# Required for moderation and matching in production
ML_SERVICE_URL=https://your-ml-service.example

# Required only when users upload photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional rejection emails through Resend
RESEND_API_KEY=
FROM_EMAIL=BagCheck <noreply@your-verified-domain.example>
